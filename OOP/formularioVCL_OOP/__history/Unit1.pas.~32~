unit Unit1;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls;

type
  // Classe TPessoa primeiro
  TPessoa = class
  private
    FNome: String;
    FIdade: Integer;
  public
    constructor Create(Nome: String; Idade: Integer);
    procedure ExibirDados;
  end;

  TForm1 = class(TForm)
    Edit1: TEdit;
    Edit2: TEdit;
    Button1: TButton;
    Button2: TButton;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
  private
    Pessoa: TPessoa;
  public
  end;

var
  Form1: TForm1;

implementation

{$R *.dfm}

// ====================== TPessoa ==========================
constructor TPessoa.Create(Nome: String; Idade: Integer);
begin
  FNome := Nome;
  FIdade := Idade;
  ShowMessage('Pessoa criada!');
end;

procedure TPessoa.ExibirDados;
begin
  ShowMessage('Nome: ' + FNome + ' | Idade: ' + FIdade.ToString);
end;

// ====================== Form1 ============================
procedure TForm1.FormCreate(Sender: TObject);
begin
  Pessoa := nil; // inicializa
end;

procedure TForm1.FormDestroy(Sender: TObject);
begin
  Pessoa.Free; // Libera se existir
end;

procedure TForm1.Button1Click(Sender: TObject);
begin
  if Assigned(Pessoa) then
  begin
    Pessoa.Free;
    Pessoa := nil; // Evita acesso inválido
    ShowMessage('Pessoa liberada da memória!');
  end
  else
    ShowMessage('Nenhuma pessoa criada!');
end;

procedure TForm1.Button2Click(Sender: TObject);
begin
  if Assigned(Pessoa) then
    ShowMessage('Já existe uma pessoa criada!')
  else
  begin
    Pessoa := TPessoa.Create(Edit1.Text, StrToIntDef(Edit2.Text, 0));
    Pessoa.ExibirDados;
  end;
end;

end.

