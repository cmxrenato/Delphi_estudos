unit uProduto;

interface
uses
  Vcl.Dialogs, System.SysUtils;
type
  TProduto = class
  private
    FNome : String;
    FPreco : Double;
    procedure SetNome(const Value:String);
    procedure SetPreco(Value:Double);

  public
    constructor Create(Nome:String; Preco:Double);
    destructor Destroy;override;
    procedure ExibirDados;

    property Nome:String read FNome write SetNome;
    property Preco:Double read FPreco write SetPreco;


end;

implementation

constructor TProduto.Create(Nome: string; Preco: Double);
begin
  FNome:=Nome;
  FPreco:=Preco;
  ShowMessage('Pessoa criada');
end;
destructor TProduto.Destroy;
begin
  ShowMessage('Memória Liberada');
  inherited Destroy;
end;
    procedure TProduto.ExibirDados;
    begin
      ShowMessage('Nome: '+FNome+' | Preco: '+FPreco.ToString);
    end;
procedure TProduto.SetNome(const Value: string);
begin
  if Value <> '' then
  FNome := Value;
end;
end.
